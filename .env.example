# Grafana Faro (Frontend Observability)
# Pega aquí el collector URL que te da Grafana Cloud Faro.
VITE_FARO_COLLECTOR_URL=

# Opcional (para identificar tu app en Grafana)
VITE_APP_NAME=Portafolio Sebastian
VITE_APP_VERSION=1.0.0

# Sourcemaps (opcional)
# Esto NO debe empezar con VITE_ (es un secret y no debe llegar al navegador).
# Valores: Grafana Cloud -> Frontend Observability -> tu app -> Settings -> Source Maps
FARO_SOURCEMAPS_ENDPOINT=
FARO_SOURCEMAPS_APP_ID=
FARO_SOURCEMAPS_STACK_ID=

# Token creado en Grafana.com (Access Policies) con scopes: sourcemaps:read, sourcemaps:write, sourcemaps:delete
FARO_SOURCEMAPS_API_KEY=
